{
  "name": "luna-neco-ranking",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://lunaneco.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luna-neco-ranking",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
